{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scmos-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "scmos-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "server/Scmos.Api",
        "--no-launch-profile",
        "--",
        "--urls",
        "http://localhost:5080",
        "--environment",
        "Development"
      ],
      "port": 5080
    }
  ]
}