# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/outputs/
/work/

# The register carries real driver names, phone numbers and plates. Exports and
# database snapshots stay on the machine that made them.
/migration/*.json
/migration/*.sqlite

# .NET
/server/**/bin/
/server/**/obj/
/server/**/appsettings.Local.json

# Build artefacts
tsconfig.tsbuildinfo
/migration/.export-copy.sqlite*

# Operational data files.
#
# ops.json carries real customer names, driver names and driver phone numbers.
# rates.json carries eighteen subcontractors' negotiated prices, which each of
# them would consider commercial-in-confidence.
#
# Neither has ever been tracked, and this repository has a remote — git history
# is effectively permanent, so they stay out of it. The register itself now
# lives in Azure SQL; see migration/README.md to rebuild these locally.
/public/data/ops.json

# rates.json now lives under migration/ and is loaded into Azure SQL by
# --seed-suppliers. It is not served to the browser at all any more.
/migration/data/

# Deployment packages — built locally, never committed.
/publish/

# Zips built by infra/pack.py — rebuilt on demand, never committed.
*.zip
